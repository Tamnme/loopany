def send_mac_ping(custom_msg=None):
    msg = custom_msg or random.choice(PING_MESSAGES)
    # 1. Native macOS Notification with Sound
    osa_cmd = [
        "osascript", "-e",
        f'display notification "{msg}" with title "🫖 Room 402 · Late-Night Conductor" sound name "Glass"'
    ]
    try:
        subprocess.run(osa_cmd, check=False)
    except Exception as e:
        print(f"Notification error: {e}")

    # 2. Pop up the browser
    url = "http://127.0.0.1:7332"
    try:
        subprocess.run(["open", url], check=False)
    except Exception:
        import webbrowser
        webbrowser.open(url)

    print(f"🔔 \033[1;32mPinged & Popped up browser!\033[0m\n> {msg}")


def parse_duration(s):
    s = s.strip().lower()
    if s.endswith("s"):
        return int(s[:-1])
    if s.endswith("m"):
        return int(s[:-1]) * 60
    if s.endswith("h"):
        return int(s[:-1]) * 3600
    try:
        return int(s) * 60  # Default to minutes
    except ValueError:
        return 1800  # Default 30 min


def run_ping_daemon(interval_sec, single_shot=False):
    if single_shot:
        print(f"⏳ Waiting {interval_sec}s before popping up Room 402 studio...")
        time.sleep(interval_sec)
        send_mac_ping()
        return

    print(f"🫖 Room 402 Ping Daemon running. Will pop up browser every {interval_sec // 60} minutes. Press Ctrl+C to stop.")
    while True:
        try:
            time.sleep(interval_sec)
            send_mac_ping()
        except (KeyboardInterrupt, EOFError):
            print("\n*Ping daemon stopped.*")
            break


