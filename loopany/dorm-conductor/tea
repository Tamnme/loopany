def run_chat():
    print("\n☕ \033[1;33mLate-Night Tea Chat in Room 402\033[0m (Type 'exit' or Ctrl+C to stop)\n")
    from conductor_web import generate_conductor_reply, load_chat_history, save_chat_history

    while True:
        try:
            msg = input("\nYou (Architect) > ").strip()
            if not msg or msg.lower() in ("exit", "quit"):
                print("\n*Sets mug down.* Get some rest before rehearsal.")
                break
            
            history = load_chat_history()
            print("\n*Maestro is steeping tea and reflecting on the score...*")
            reply = generate_conductor_reply(msg, history)
            
            history.append({"role": "user", "content": msg})
            history.append({"role": "assistant", "content": reply})
            save_chat_history(history)

            print(f"\n\033[1;35mMaestro Flatmate:\033[0m\n{reply}")
        except (KeyboardInterrupt, EOFError):
            print("\n*Steam curls from the teapot.* Goodnight.")
            break


def list_dialogues():
    print("\n📜 \033[1;33mARCHITECTURAL SCORE MOVEMENTS & DIALOGUES\033[0m\n")
    if not DIALOGUES_DIR.exists():
        print("No movements recorded yet.")
        return
    files = sorted(DIALOGUES_DIR.glob("*.md"), reverse=True)
    for f in files:
        title = f.stem.replace("-", " ").title()
        print(f"  • \033[1;36m{f.stem[:10]}\033[0m  {title}")
    print()


def main():
    args = sys.argv[1:]
    if not args:
        print("☕ Opening Room 402 Conductor Studio in browser...")
        subprocess.run(["python3", str(WEB_SCRIPT), "--open"])
        return

    cmd = args[0].lower()

    if cmd in ("ping", "-p", "--ping"):
        if len(args) == 1:
            send_mac_ping()
            return
        
        sub = args[1].lower()
        if sub in ("--after", "-a") and len(args) > 2:
            sec = parse_duration(args[2])
            run_ping_daemon(sec, single_shot=True)
            return
        elif sub in ("--every", "-e") and len(args) > 2:
            sec = parse_duration(args[2])
            run_ping_daemon(sec, single_shot=False)
            return
        else:
            send_mac_ping()
            return

    if cmd in ("quiz", "-q", "--quiz"):
        run_quiz()
        return

    if cmd in ("chat", "-c", "--chat"):
        run_chat()
        return

    if cmd in ("archive", "-a", "--archive", "list", "dialogues"):
        list_dialogues()
        return

    if cmd in ("--status", "-s", "status"):
        if INBOX.exists():
            text = INBOX.read_text(encoding="utf-8").replace(PLACEHOLDER, "").strip()
            if text:
                print(f"🟢 \033[1;32mDilemma queued for tonight's tea:\033[0m\n---\n{text}\n---")
                return
        print("⚪ Inbox is clear. Roommate will lead with tonight's foundational score lesson.")
        return

    if cmd in ("--clear", "-c", "clear"):
        INBOX.write_text(f"{PLACEHOLDER}\n", encoding="utf-8")
        print("🧹 Inbox cleared.")
        return

    if cmd in ("--web", "-w", "web"):
        subprocess.run(["python3", str(WEB_SCRIPT), "--open"])
        return

    # Treat remaining args as a poured message
    msg = " ".join(args).strip()
    INBOX.write_text(f"{PLACEHOLDER}\n\n{msg}\n", encoding="utf-8")
    print(f"☕ \033[1;32mPoured into inbox!\033[0m Your roommate will address this tonight at 22:00:\n> {msg}")


if __name__ == "__main__":
    main()
